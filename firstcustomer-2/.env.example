# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firstcustomer

# Canonical public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FirstCustomer economics (server-authoritative)
FC_LAUNCH_FEE_CENTS=900
FC_PLATFORM_FEE_BPS=1000
FC_MIN_REWARD_CENTS=500
FC_NETWORK_NOTIFICATION_LIMIT=25

# Stripe: required for live company checkout and automatic payouts
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional FirstCustomer Network mission alerts via Resend
RESEND_API_KEY=re_...
EMAIL_FROM=FirstCustomer <alerts@yourdomain.com>

# Local-only convenience. NEVER enable this in production.
ALLOW_DEMO_BILLING=true
